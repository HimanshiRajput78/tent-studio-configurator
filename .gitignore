@'
# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies and builds
node_modules/
dist/
dist-ssr/
*.local

# Environment variables and secrets
.env
.env.*
!.env.example
server/.env
server/.env.*
!server/.env.example

# Editor files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Private keys
*.pem
*.key


# Local backup files
/server/index-current.txt
/server/server/
'@ | Add-Content .gitignore